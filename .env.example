# Cấu hình Server
PORT=5000

# Cấu hình MangaDex API
MANGADEX_BASE_URL=https://api.mangadex.org
MANGADEX_UPLOADS_URL=https://uploads.mangadex.org

# Cấu hình Firebase Admin SDK (Tuỳ chọn - dùng để cache dữ liệu vào Firestore)
# Cách 1: Đặt đường dẫn tới file JSON Service Account tải từ Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Cách 2: Hoặc cấu hình trực tiếp các biến dưới đây
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Thời gian lưu cache danh sách truyện phổ biến trên Firestore (tính bằng giây, mặc định 900s = 15 phút)
CACHE_TTL_SECONDS=900
